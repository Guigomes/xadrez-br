# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chatbot de suporte (docs/plano-chatbot-suporte.md) — nunca prefixar com
# NEXT_PUBLIC_, essas chaves só são usadas server-side.
# CHAT_LLM_PROVIDER escolhe o provedor de geração: 'gemini' (free tier,
# padrão) ou 'anthropic' (pago, sem teto). Só preencher a chave do provedor
# escolhido é necessário.
CHAT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Modelo do Gambito (só usado com CHAT_LLM_PROVIDER=anthropic). Vazio = Haiku.
# CHAT_LLM_MODEL=claude-haiku-4-5-20251001

# Permite chat anônimo (sem login) + uso das ferramentas do Gambito. Reversível:
# volte pra false pra exigir login de novo. É NEXT_PUBLIC_ porque o widget
# (client) e a API route leem o mesmo valor. Requer a migration 067 aplicada.
NEXT_PUBLIC_CHAT_ALLOW_ANONYMOUS=false

# Push nativo pro app Android Gambito Admin (workspace-gambito-admin) —
# service account JSON do projeto Firebase (Configurações do projeto >
# Contas de serviço > Gerar nova chave privada), colado como uma linha só.
FIREBASE_SERVICE_ACCOUNT_JSON=
